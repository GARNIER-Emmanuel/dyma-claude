{
  "description": "Transmet l'état Git de JobView au démarrage et à la reprise d'une session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(require('node:child_process').execFileSync('git', ['rev-parse', '--show-toplevel'], {encoding: 'utf8'}).trim(), '.codex/hooks/session-start.cjs'))\"",
            "timeout": 10,
            "statusMessage": "Lecture de l'état Git de JobView"
          }
        ]
      }
    ]
  }
}